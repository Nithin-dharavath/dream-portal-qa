{
  "name": "dream-portal-qa",
  "version": "1.0.0",
  "description": "Playwright test automation for Dream Portal (https://arjitnigam.github.io/myDreams/)",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:allure": "npx allure serve allure-results",
    "report:generate": "npx allure generate allure-results --clean -o allure-report"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "dream-portal",
    "qa"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "allure-playwright": "^3.11.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
